{
  "name": "linkautowork-mvo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx gateway/src/server.ts",
    "start": "node dist/gateway/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:templates": "node scripts/validate-templates.mjs",
    "ci": "npm run validate:templates && npm run test && npm run typecheck"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^6.1.1",
    "express": "^4.21.2",
    "nats": "^2.29.3",
    "prom-client": "^15.1.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.2"
  }
}

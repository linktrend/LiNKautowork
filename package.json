{
  "name": "linkautowork-mvo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx gateway/src/server.ts",
    "start": "node dist/gateway/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:templates": "node scripts/validate-templates.mjs",
    "validate:automations": "node scripts/validate-automation-packages.mjs",
    "build:catalog": "node scripts/build-automation-catalog.mjs",
    "catalog:check": "node scripts/build-automation-catalog.mjs --check",
    "release:check": "node scripts/release-readiness-check.mjs",
    "test:catalog": "vitest run",
    "test:automation-architect": "npm --prefix packages/automation-architect run test",
    "test:automation-contracts": "npm --prefix packages/automation-contracts run test",
    "test:automation-operations": "npm --prefix packages/automation-operations run test",
    "test:product-api": "npm --prefix apps/product-api run test",
    "test:operator-console": "npm --prefix apps/operator-console run test",
    "test:client-product": "npm --prefix apps/web run test",
    "test:browser": "npm --prefix apps/web run test:browser",
    "test:automation-librarian": "vitest run gateway/tests/automation-librarian.test.ts",
    "test:automation-evals": "npm --prefix packages/automation-eval-runner run test",
    "eval:smoke": "node scripts/run-automation-evals.mjs --profile=smoke",
    "eval:full": "node scripts/run-automation-evals.mjs --profile=full",
    "typecheck:automation-architect": "npm --prefix packages/automation-architect run typecheck",
    "typecheck:automation-contracts": "npm --prefix packages/automation-contracts run typecheck",
    "typecheck:automation-operations": "npm --prefix packages/automation-operations run typecheck",
    "typecheck:product-api": "npm --prefix apps/product-api run typecheck",
    "build:product-api": "npm --prefix apps/product-api run build:production",
    "build:operator-console": "npm --prefix apps/operator-console run build",
    "typecheck:operator-console": "npm --prefix apps/operator-console run typecheck",
    "build:client-product": "npm --prefix apps/web run build",
    "typecheck:client-product": "npm --prefix apps/web run typecheck",
    "typecheck:automation-librarian": "tsc -p tsconfig.json --noEmit",
    "verify:automation-librarian-db": "npm --prefix packages/automation-contracts run verify:db",
    "restore:rehearse": "npm --prefix packages/automation-contracts run verify:db",
    "test:packages": "npm run test:automation-architect && npm run test:automation-contracts && npm run test:automation-operations",
    "typecheck:packages": "npm run typecheck:automation-architect && npm run typecheck:automation-contracts && npm run typecheck:automation-operations",
    "ci": "npm run release:check && npm run validate:templates && npm run validate:automations && npm run catalog:check && npm run test && npm run test:packages && npm run test:product-api && npm run test:operator-console && npm run test:client-product && npm run test:automation-librarian && npm run verify:automation-librarian-db && npm run test:automation-evals && npm run eval:smoke && npm run eval:full && npm run restore:rehearse && npm run typecheck && npm run typecheck:packages && npm run typecheck:product-api && npm run build:product-api && npm run build:operator-console && npm run typecheck:operator-console && npm run build:client-product && npm run typecheck:client-product && npm run test:browser && npm run typecheck:automation-librarian"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^6.1.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "nats": "^2.29.3",
    "prom-client": "^15.1.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "playwright": "^1.57.0",
    "supertest": "^7.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "protobufjs": "^7.5.6",
    "qs": "^6.15.2"
  }
}

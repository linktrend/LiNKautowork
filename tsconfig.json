{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node", "vitest/globals"],
    "resolveJsonModule": true
  },
  "include": ["gateway/src/**/*.ts", "gateway/src/**/*.d.ts", "gateway/tests/**/*.ts"]
}

{
  "name": "AIOS Daily Chairman Briefing (Legacy)",
  "nodes": [
    {
      "name": "Daily Trigger 08:00 Taipei",
      "type": "n8n-nodes-base.cron",
      "parameters": {
        "timezone": "Asia/Taipei",
        "triggerTimes": {
          "item": [
            {
              "mode": "everyDay",
              "hour": 8,
              "minute": 0
            }
          ]
        }
      }
    },
    {
      "name": "Forward To Unified Ritual Gate",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "={{$env.LINKAUTOWORK_GATEWAY_URL + '/v1/events/publish'}}",
        "method": "POST",
        "sendBody": true,
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-link-service",
              "value": "n8n"
            },
            {
              "name": "x-link-service-token",
              "value": "={{$env.LINK_SERVICE_TOKEN_N8N}}"
            }
          ]
        },
        "jsonBody": "={{ { eventType: 'ritual.strategic', mission: { tenantId: '00000000-0000-0000-0000-000000000001', missionId: 'legacy-strategic-' + $now.toISODate(), runId: 'legacy-strategic-run-' + $now.toISODate(), taskId: 'legacy-strategic-task-' + $now.toISODate(), dprId: 'legacy-strategic-dpr-' + $now.toISODate(), triggerSource: 'n8n.legacy' }, status: 'ok', payload: { note: 'Legacy strategic briefing compatibility path' } } }}"
      }
    }
  ],
  "connections": {
    "Daily Trigger 08:00 Taipei": {
      "main": [
        [
          {
            "node": "Forward To Unified Ritual Gate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.dev/schemas/linkautowork/provenance-sources-v0.1.schema.json",
  "title": "LiNKautowork Provenance Sources v0.1",
  "description": "Traceable source and licence record. It never stores raw source data or credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "automation_id", "automation_version", "required_runtime", "sources", "source_to_target_map", "review"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "automation_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
    "automation_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "required_runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "n8n_version"],
      "properties": {
        "engine": { "const": "n8n" },
        "n8n_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" }
      }
    },
    "sources": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "kind", "locator", "revision", "content_digest", "license", "commercial_use", "adaptation_status"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
          "kind": { "enum": ["internal", "n8n_template", "make_blueprint", "zapier_export", "github_repository", "open_source_project", "documentation", "manual_specification"] },
          "locator": { "type": "string", "format": "uri", "maxLength": 2048 },
          "revision": { "type": "string", "minLength": 1, "maxLength": 256 },
          "content_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "license": { "type": "string", "pattern": "^(LicenseRef-[A-Za-z0-9.-]+|[A-Za-z0-9.-]+)$" },
          "commercial_use": { "enum": ["allowed", "not_applicable"] },
          "adaptation_status": { "enum": ["reference_only", "adapted", "reimplemented", "not_used"] }
        }
      }
    },
    "source_to_target_map": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "source_content_digest", "source_component_ref", "target_component_ref", "action", "reason"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
          "source_content_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "source_component_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
          "target_component_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
          "action": { "enum": ["reference_only", "adapted", "reimplemented", "not_used"] },
          "reason": { "type": "string", "minLength": 3, "maxLength": 1000 }
        }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reviewer_role", "conclusion"],
      "properties": {
        "status": { "enum": ["cleared", "not_applicable"] },
        "reviewer_role": { "type": "string", "minLength": 3, "maxLength": 160 },
        "conclusion": { "type": "string", "minLength": 10, "maxLength": 2000 }
      }
    }
  }
}

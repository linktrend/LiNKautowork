{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.dev/schemas/linkautowork/deployment-profile-v0.1.schema.json",
  "title": "LiNKautowork Deployment Profile v0.1",
  "description": "Promotion and instance-deployment policy. Configuration and secret declarations are references only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "supported_environments", "promotion", "instance_isolation", "configuration", "rollback"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
    "supported_environments": { "type": "array", "minItems": 1, "items": { "enum": ["development", "stage", "production"] }, "uniqueItems": true },
    "promotion": {
      "type": "object", "additionalProperties": false,
      "required": ["canary_required", "independent_approval_required"],
      "properties": { "canary_required": { "type": "boolean" }, "independent_approval_required": { "const": true } }
    },
    "instance_isolation": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "separate_workflow_copy", "separate_credential_scope"],
      "properties": {
        "mode": { "const": "logical_shared_n8n" },
        "separate_workflow_copy": { "const": true },
        "separate_credential_scope": { "const": true }
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["configuration_reference_required", "secret_values_permitted"],
      "properties": {
        "configuration_reference_required": { "const": true },
        "secret_values_permitted": { "const": false }
      }
    },
    "rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["previous_certified_release_required", "operator_runbook_required"],
      "properties": { "previous_certified_release_required": { "const": true }, "operator_runbook_required": { "const": true } }
    }
  }
}

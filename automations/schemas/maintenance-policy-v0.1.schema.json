{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.dev/schemas/linkautowork/maintenance-policy-v0.1.schema.json",
  "title": "LiNKautowork Maintenance Policy v0.1",
  "description": "Bounded recovery policy. Workflow logic repair always creates a candidate release and cannot modify production in place.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "automatic_actions", "escalation", "candidate_change_policy"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "policy_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
    "automatic_actions": {
      "type": "array", "items": { "enum": ["none", "retry", "restart_worker", "rollback_configuration", "disable_instance"] }, "uniqueItems": true
    },
    "escalation": {
      "type": "object", "additionalProperties": false,
      "required": ["create_maintenance_issue", "severity_threshold"],
      "properties": {
        "create_maintenance_issue": { "const": true },
        "severity_threshold": { "enum": ["warning", "critical"] }
      }
    },
    "candidate_change_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow_logic_change", "independent_eval_required", "production_in_place_change_allowed"],
      "properties": {
        "workflow_logic_change": { "const": "new_release_candidate" },
        "independent_eval_required": { "const": true },
        "production_in_place_change_allowed": { "const": false }
      }
    }
  }
}

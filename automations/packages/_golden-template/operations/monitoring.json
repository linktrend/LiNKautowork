{
  "schema_version": "0.1",
  "profile_id": "golden-example-monitoring",
  "slo": { "success_rate_target": 1, "max_latency_ms": 5000, "missed_schedule_tolerance": 0 },
  "signals": ["execution_success", "execution_failure", "latency"],
  "alerts": [
    { "signal": "execution_failure", "severity": "warning", "condition": "Any evaluation execution fails.", "route_key": "linkautowork.operator-review" }
  ],
  "health_checks": [
    { "check_id": "golden-run-completion", "kind": "run_completion", "interval_seconds": 3600 }
  ]
}

{
  "schema_version": "0.1",
  "profile_id": "server01-runtime-acceptance-monitoring",
  "slo": { "success_rate_target": 1, "max_latency_ms": 5000, "missed_schedule_tolerance": 0 },
  "signals": ["execution_success", "execution_failure", "latency", "output_contract_failure"],
  "alerts": [
    { "signal": "execution_failure", "severity": "warning", "condition": "Any mocked acceptance case fails closed.", "route_key": "linkautowork.operator-review" }
  ],
  "health_checks": [
    { "check_id": "server01-runtime-acceptance-completion", "kind": "run_completion", "interval_seconds": 3600 }
  ]
}

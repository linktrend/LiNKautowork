{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/linktrend/LiNKlibraries/schemas/library-entry.schema.json",
  "title": "LiNKlibraries entry metadata",
  "description": "Canonical entry contract v2. Earlier schemaVersion 1 records are migration-only and do not validate as production entries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entryId",
    "kind",
    "name",
    "summary",
    "problemDomains",
    "tags",
    "languages",
    "frameworks",
    "state",
    "contentMode",
    "selectable",
    "compatibility",
    "dependencies",
    "license",
    "securityReview",
    "usage",
    "integrationNotes",
    "gotchas",
    "provenance",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "entryId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 128
    },
    "kind": {
      "type": "string",
      "enum": [
        "custom_component",
        "code_pattern",
        "template",
        "starter_kit",
        "vetted_oss"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "problemDomains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "usable",
        "metadata_only",
        "deprecated",
        "quarantined",
        "superseded",
        "rejected"
      ]
    },
    "contentMode": {
      "type": "string",
      "enum": ["executable", "documentation"]
    },
    "selectable": {
      "type": "boolean"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "dependencies": {
      "$ref": "#/$defs/dependencies"
    },
    "testContract": {
      "$ref": "#/$defs/testContract"
    },
    "license": {
      "$ref": "#/$defs/license"
    },
    "securityReview": {
      "$ref": "#/$defs/securityReview"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["howToUse"],
      "properties": {
        "howToUse": {
          "type": "string",
          "minLength": 1
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "integrationNotes": {
      "type": "string",
      "minLength": 1
    },
    "gotchas": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "supersededBy": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 128
    },
    "quarantine": {
      "$ref": "#/$defs/quarantine"
    },
    "deprecation": {
      "$ref": "#/$defs/deprecation"
    }
  },
  "$defs": {
    "entryId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 128
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "runtimes"],
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "runtimes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "operatingSystems": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "packageDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "ecosystem"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 214
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ecosystem": {
          "type": "string",
          "enum": ["npm", "pypi", "cargo", "go", "maven", "nuget", "other"]
        },
        "optional": {
          "type": "boolean"
        }
      }
    },
    "serviceDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "purpose", "required"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 214
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packages", "services"],
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packageDependency"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serviceDependency"
          }
        }
      }
    },
    "testContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "files", "timeoutMs"],
      "properties": {
        "runner": {
          "type": "string",
          "enum": ["node:test", "tsx", "vitest", "jest", "pytest"]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
            "minLength": 1
          }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "redistributionAllowed"],
      "properties": {
        "spdx": {
          "type": "string",
          "format": "spdx-expression"
        },
        "redistributionAllowed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "securityReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewedAt", "reviewedBy", "notes"],
      "properties": {
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSystem", "sourceRevisionSha", "contributedAt"],
      "properties": {
        "sourceSystem": {
          "type": "string",
          "enum": ["ide-development", "linkdeveloper", "manual", "migration"]
        },
        "sourceRevisionSha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "contributedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "versionOrRange": {
          "type": "string",
          "minLength": 1
        },
        "productRunId": {
          "type": "string",
          "minLength": 1
        },
        "pullRequestNumber": {
          "type": "integer",
          "minimum": 1
        },
        "pullRequestUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "quarantine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "reportedAt", "reportedBy"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "reportedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reportedBy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "deprecatedAt"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "deprecatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "usable"
          }
        }
      },
      "then": {
        "properties": {
          "selectable": {
            "const": true
          }
        },
        "required": ["selectable"]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": ["metadata_only", "quarantined", "superseded", "rejected"]
          }
        }
      },
      "then": {
        "properties": {
          "selectable": {
            "const": false
          }
        },
        "required": ["selectable"]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "deprecated"
          }
        }
      },
      "then": {
        "properties": {
          "selectable": {
            "const": false
          },
          "deprecation": {
            "$ref": "#/$defs/deprecation"
          }
        },
        "required": ["deprecation"]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "superseded"
          }
        }
      },
      "then": {
        "properties": {
          "supersededBy": {
            "$ref": "#/$defs/entryId"
          }
        },
        "required": ["supersededBy"]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "quarantined"
          }
        }
      },
      "then": {
        "properties": {
          "quarantine": {
            "$ref": "#/$defs/quarantine"
          }
        },
        "required": ["quarantine"]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": ["usable", "deprecated"]
          },
          "contentMode": {
            "const": "executable"
          }
        }
      },
      "then": {
        "properties": {
          "testContract": {
            "$ref": "#/$defs/testContract"
          }
        },
        "required": ["testContract"]
      }
    },
    {
      "if": {
        "properties": {
          "contentMode": {
            "const": "documentation"
          }
        }
      },
      "then": {
        "not": {
          "required": ["testContract"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "metadata_only"
          }
        }
      },
      "then": {
        "properties": {
          "contentMode": {
            "const": "documentation"
          },
          "dependencies": {
            "type": "object",
            "properties": {
              "packages": {
                "type": "array",
                "maxItems": 0
              },
              "services": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        "not": {
          "required": ["testContract"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "vetted_oss"
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "type": "object",
            "properties": {
              "sourceUrl": {
                "type": "string",
                "format": "uri"
              },
              "versionOrRange": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["sourceUrl", "versionOrRange"]
          }
        }
      }
    }
  ]
}

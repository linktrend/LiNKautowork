{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.local/contracts/verification-run.schema.json",
  "title": "PKT-08 durable verification run",
  "description": "Strict durable binding for long Full verification commands.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "amendment",
    "runId",
    "packetId",
    "profile",
    "repository",
    "canonicalCheckout",
    "cwd",
    "commit",
    "tree",
    "command",
    "commandDigest",
    "logPath",
    "receiptPath",
    "startedAt",
    "lastHeartbeatAt",
    "timeoutSeconds",
    "durableHandle",
    "state",
    "restartCount"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "amendment": {
      "type": "string",
      "const": "V25_PKT08_VERIFICATION_LIVENESS"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "packetId": {
      "type": "string",
      "pattern": "^PKT-[0-9]{2,}$"
    },
    "profile": {
      "type": "string",
      "const": "Full"
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "canonicalCheckout": {
      "type": "string",
      "minLength": 1
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "$ref": "#/$defs/sha40"
    },
    "tree": {
      "$ref": "#/$defs/sha40"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commandDigest": {
      "$ref": "#/$defs/sha256"
    },
    "logPath": {
      "type": "string",
      "minLength": 1
    },
    "receiptPath": {
      "type": "string",
      "minLength": 1
    },
    "startedAt": {
      "type": "string",
      "minLength": 1
    },
    "lastHeartbeatAt": {
      "type": "string",
      "minLength": 1
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "durableHandle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["local_pid", "hosted_check"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "STARTED",
        "LIVE",
        "TERMINAL",
        "ORPHANED",
        "TIMED_OUT",
        "RESTARTED"
      ]
    },
    "restartCount": {
      "type": "integer",
      "minimum": 0
    },
    "completionEvidence": {
      "type": ["object", "null"],
      "additionalProperties": true
    }
  },
  "$defs": {
    "sha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}

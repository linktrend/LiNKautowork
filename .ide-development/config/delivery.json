{
  "schemaVersion": 2,
  "mode": "phase-integration",
  "compute": {
    "provider": "github-hosted",
    "runner": "ubuntu-24.04-arm",
    "checkpointCI": false,
    "cancelObsolete": true,
    "maxInfrastructureAttempts": 2,
    "maxSealedCandidates": 2
  },
  "profiles": {
    "fast": {
      "commands": [],
      "timeoutMinutes": 5
    },
    "full": {
      "commands": [],
      "required": true
    },
    "release": {
      "commands": []
    }
  },
  "promotion": {
    "reuseExactReceipt": true,
    "identity": [
      "repository",
      "gitTree",
      "dependencyDigest",
      "profileDigest",
      "workflowDigest"
    ]
  },
  "review": {
    "bugbot": "final-candidate-only"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.local/managed-core/delivery-modes.schema.json",
  "title": "IDE Development managed-core delivery modes",
  "description": "Configurable delivery mode config, Issue PR risk exceptions, and Phase delivery records.",
  "$defs": {
    "sha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "deliveryModeId": {
      "type": "string",
      "enum": ["issue-pr", "phase-integration"]
    },
    "riskClass": {
      "type": "string",
      "enum": [
        "security",
        "authentication",
        "database_migration",
        "infrastructure",
        "major_shared_api",
        "unusually_large_scope",
        "cross_phase_impact"
      ]
    },
    "namedGateId": {
      "type": "string",
      "enum": ["fast-gate", "staging-gate", "release-gate"]
    },
    "gateStatus": {
      "type": "string",
      "enum": ["success", "pending", "failed", "missing"]
    },
    "deliveryModeConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "deliveryMode"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "deliveryMode": { "$ref": "#/$defs/deliveryModeId" },
        "phaseBranchPrefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+/$",
          "default": "phase/"
        }
      }
    },
    "command": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(?!/)(?!~)(?![A-Za-z]:[\\\\/]).+"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      ]
    },
    "testProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "timeoutSeconds"],
      "properties": {
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "fullTestProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "required", "timeoutSeconds"],
      "properties": {
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        },
        "required": { "type": "boolean" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "testProfiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fast", "full", "release"],
      "properties": {
        "fast": { "$ref": "#/$defs/testProfile" },
        "full": { "$ref": "#/$defs/fullTestProfile" },
        "release": { "$ref": "#/$defs/testProfile" }
      }
    },
    "resourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fastCpus", "fastMemoryMiB", "heavyCpus", "heavyMemoryMiB",
        "pidsLimit", "pauseCpuPercent", "pauseMemoryPercent", "minimumFreeDiskGiB"
      ],
      "properties": {
        "fastCpus": { "type": "number", "exclusiveMinimum": 0 },
        "fastMemoryMiB": { "type": "integer", "minimum": 128 },
        "heavyCpus": { "type": "number", "exclusiveMinimum": 0 },
        "heavyMemoryMiB": { "type": "integer", "minimum": 128 },
        "pidsLimit": { "type": "integer", "minimum": 64 },
        "pauseCpuPercent": { "type": "integer", "minimum": 1, "maximum": 100 },
        "pauseMemoryPercent": { "type": "integer", "minimum": 1, "maximum": 100 },
        "minimumFreeDiskGiB": { "type": "number", "minimum": 0 }
      }
    },
    "deliveryRuntimeConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "deliveryMode", "phaseBranchPrefix", "orchestrationMode",
        "fastTargetSeconds", "maxAttemptsPerCandidate", "maxSealedCandidateRevisions",
        "maxFastJobs", "maxHeavyJobs", "stagingPromotion", "mainPromotion",
        "testProfiles", "dependencyFiles", "resourceLimits"
      ],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 2 },
        "deliveryMode": { "$ref": "#/$defs/deliveryModeId" },
        "phaseBranchPrefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+/$"
        },
        "orchestrationMode": {
          "type": "string",
          "enum": ["local-coordinator", "github-actions"]
        },
        "fastTargetSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "maxAttemptsPerCandidate": { "type": "integer", "const": 2 },
        "maxSealedCandidateRevisions": { "type": "integer", "const": 2 },
        "maxFastJobs": { "type": "integer", "enum": [1, 2] },
        "maxHeavyJobs": { "type": "integer", "const": 1 },
        "stagingPromotion": { "type": "string", "enum": ["automatic", "principal-approval"] },
        "mainPromotion": { "type": "string", "enum": ["automatic", "principal-approval"] },
        "testProfiles": { "$ref": "#/$defs/testProfiles" },
        "dependencyFiles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "resourceLimits": { "$ref": "#/$defs/resourceLimits" }
      }
    },
    "hostedCommand": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "hostedProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/hostedCommand" }
        },
        "timeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "hostedFastProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "timeoutMinutes"],
      "properties": {
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/hostedCommand" }
        },
        "timeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "hostedFullProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "required"],
      "properties": {
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/hostedCommand" }
        },
        "required": { "type": "boolean" },
        "timeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "hostedIdentity": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["repository", "gitTree", "dependencyDigest", "profileDigest", "workflowDigest"]
      },
      "allOf": [
        { "contains": { "const": "repository" } },
        { "contains": { "const": "gitTree" } },
        { "contains": { "const": "dependencyDigest" } },
        { "contains": { "const": "profileDigest" } },
        { "contains": { "const": "workflowDigest" } }
      ]
    },
    "hostedDeliveryConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "mode", "compute", "profiles", "promotion", "review"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 2 },
        "mode": { "$ref": "#/$defs/deliveryModeId" },
        "compute": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider", "runner", "checkpointCI", "cancelObsolete",
            "maxInfrastructureAttempts", "maxSealedCandidates"
          ],
          "properties": {
            "provider": { "type": "string", "const": "github-hosted" },
            "runner": { "type": "string", "const": "ubuntu-24.04-arm" },
            "checkpointCI": { "type": "boolean", "const": false },
            "cancelObsolete": { "type": "boolean", "const": true },
            "maxInfrastructureAttempts": { "type": "integer", "const": 2 },
            "maxSealedCandidates": { "type": "integer", "const": 2 }
          }
        },
        "profiles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fast", "full", "release"],
          "properties": {
            "fast": { "$ref": "#/$defs/hostedFastProfile" },
            "full": { "$ref": "#/$defs/hostedFullProfile" },
            "release": { "$ref": "#/$defs/hostedProfile" }
          }
        },
        "promotion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reuseExactReceipt", "identity"],
          "properties": {
            "reuseExactReceipt": { "type": "boolean", "const": true },
            "identity": { "$ref": "#/$defs/hostedIdentity" }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bugbot"],
          "properties": {
            "bugbot": { "type": "string", "const": "final-candidate-only" }
          }
        },
        "amendment": { "type": "string", "const": "V25_BOOTSTRAP_LEAN" },
        "issueCheckpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["acceptWithoutReviewReady", "acceptWithoutToken", "requiredEvidence"],
          "properties": {
            "acceptWithoutReviewReady": { "type": "boolean", "const": true },
            "acceptWithoutToken": { "type": "boolean", "const": true },
            "requiredEvidence": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "exact_pushed_commit_tree",
                  "scoped_diff",
                  "focused_tests",
                  "independent_terra_verification",
                  "manifest_evidence"
                ]
              }
            }
          }
        },
        "publisherAuthority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonicalForV25", "missingOrFailedClassification"],
          "properties": {
            "canonicalForV25": { "type": "string", "const": "none" },
            "missingOrFailedClassification": { "type": "string", "const": "WAIVED_LEGACY_GATE" }
          }
        },
        "administratorRecovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namedExceptionOnly", "preferAdminMatchHeadCommit"],
          "properties": {
            "namedExceptionOnly": { "type": "boolean", "const": true },
            "preferAdminMatchHeadCommit": { "type": "boolean", "const": true },
            "allowedOperations": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["protection_snapshot", "restore", "readback"]
              }
            }
          }
        }
      }
    },
    "issuePrException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "riskClass"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "riskClass": { "$ref": "#/$defs/riskClass" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "acceptedIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "sha", "accepted", "included"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "sha": { "$ref": "#/$defs/sha40" },
        "accepted": { "type": "boolean" },
        "included": { "type": "boolean" }
      }
    },
    "namedGateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "sha", "status", "detail", "checks"],
      "properties": {
        "gate": { "$ref": "#/$defs/namedGateId" },
        "sha": { "type": "string" },
        "status": { "$ref": "#/$defs/gateStatus" },
        "detail": { "type": "string" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "state"],
            "properties": {
              "name": { "type": "string" },
              "state": { "type": "string" }
            }
          }
        }
      }
    },
    "phasePr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "url", "base"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "minLength": 1 },
        "base": { "type": "string", "const": "development" }
      }
    },
    "riskExceptionIssuePr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "sha", "riskClass", "prNumber"],
      "properties": {
        "branch": { "type": "string" },
        "sha": { "$ref": "#/$defs/sha40" },
        "riskClass": { "$ref": "#/$defs/riskClass" },
        "prNumber": { "type": "integer", "minimum": 1 },
        "prUrl": { "type": "string" }
      }
    },
    "phaseDeliveryRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "deliveryMode",
        "phaseBranch",
        "baseSha",
        "headSha",
        "mergeSha",
        "acceptedIssues",
        "namedGateEvidence"
      ],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "deliveryMode": { "type": "string", "const": "phase-integration" },
        "phaseBranch": { "type": "string", "minLength": 1 },
        "baseSha": { "$ref": "#/$defs/sha40" },
        "headSha": { "$ref": "#/$defs/sha40" },
        "mergeSha": {
          "anyOf": [{ "$ref": "#/$defs/sha40" }, { "type": "null" }]
        },
        "phasePr": { "$ref": "#/$defs/phasePr" },
        "acceptedIssues": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/acceptedIssue" }
        },
        "namedGateEvidence": { "$ref": "#/$defs/namedGateEvidence" },
        "riskExceptionIssuePrs": {
          "type": "array",
          "items": { "$ref": "#/$defs/riskExceptionIssuePr" }
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/deliveryModeConfig" },
    { "$ref": "#/$defs/deliveryRuntimeConfig" },
    { "$ref": "#/$defs/hostedDeliveryConfig" },
    { "$ref": "#/$defs/issuePrException" },
    { "$ref": "#/$defs/phaseDeliveryRecord" }
  ]
}

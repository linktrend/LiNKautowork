{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.local/managed-core/secret-scan-result.schema.json",
  "title": "Fixture-aware secret-scan result",
  "description": "Aggregated secret-scan findings and fixture errors from one run. Repository-owned scanner failures remain blocking.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "scannerPolicyVersion",
    "candidateTree",
    "ok",
    "findings"
  ],
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "findingKind": {
      "type": "string",
      "enum": [
        "credential_finding",
        "approved_synthetic_fixture",
        "stale_fixture_declaration",
        "fixture_scope_violation"
      ]
    }
  },
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "secret-scan-result" },
    "scannerPolicyVersion": { "type": "string", "minLength": 1 },
    "candidateTree": { "$ref": "#/$defs/sha40" },
    "ok": { "type": "boolean" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "rule"],
        "properties": {
          "kind": { "$ref": "#/$defs/findingKind" },
          "path": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "field": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 },
          "digest": { "$ref": "#/$defs/digest" },
          "fixtureId": { "type": "string", "minLength": 1 },
          "scannerId": { "type": "string", "minLength": 1 },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

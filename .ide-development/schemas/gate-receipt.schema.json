{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.local/managed-core/gate-receipt.schema.json",
  "title": "LiNKtrend exact-content FullSuiteReceipt",
  "description": "Schema version 1 receipts are migration-only and are not reusable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateIdentity",
    "workflowRunId",
    "workflowRunAttempt",
    "runnerLabel",
    "startedAt",
    "completedAt",
    "conclusion",
    "commandDigest",
    "evidenceDigests",
    "receiptDigest"
  ],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 2},
    "candidateIdentity": {"$ref": "#/$defs/candidateIdentity"},
    "workflowRunId": {"type": "integer", "minimum": 1},
    "workflowRunAttempt": {"type": "integer", "minimum": 1},
    "runnerLabel": {"type": "string", "enum": ["ubuntu-24.04-arm"]},
    "startedAt": {"$ref": "#/$defs/rfc3339Utc"},
    "completedAt": {"$ref": "#/$defs/rfc3339Utc"},
    "conclusion": {"type": "string", "const": "success"},
    "commandDigest": {"$ref": "#/$defs/digest"},
    "evidenceDigests": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/repoRelativePath"},
      "additionalProperties": {"$ref": "#/$defs/digest"}
    },
    "receiptDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "sourceBranch", "headCommit", "gitTree", "dependencyDigest", "profileDigest", "workflowDigest"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "sourceBranch": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "headCommit": {"$ref": "#/$defs/sha"},
        "gitTree": {"$ref": "#/$defs/sha"},
        "dependencyDigest": {"$ref": "#/$defs/digest"},
        "profileDigest": {"$ref": "#/$defs/digest"},
        "workflowDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/|\\\\)(?!.*\\.\\.(?:/|\\\\|$))(?!.*:)[A-Za-z0-9._@+, -]+(?:/[A-Za-z0-9._@+, -]+)*$"
    },
    "rfc3339Utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    }
  }
}

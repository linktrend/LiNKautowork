{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.local/managed-core/change-scoped-secret-scan.schema.json",
  "title": "Change-scoped secret-scan evidence",
  "description": "Exact identity envelope required before reusing inherited baseline secret-scan findings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "kind", "repository", "authoritativeRemoteRef",
    "baselineCommit", "baselineTree", "candidateCommit", "candidateGitTree",
    "scannerPolicyVersion", "managedPaths", "configDigest", "findings"
  ],
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "finding": {
      "type": "object",
      "required": ["kind", "path", "rule"],
      "properties": {
        "kind": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "field": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "fixtureId": { "type": "string", "minLength": 1 },
        "scannerId": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "change-scoped-secret-scan-evidence" },
    "repository": { "type": "string", "minLength": 3 },
    "authoritativeRemoteRef": { "type": "string", "pattern": "^(?:refs/remotes/)?[A-Za-z0-9._-]+/[A-Za-z0-9._/-]+$" },
    "baselineCommit": { "$ref": "#/$defs/sha40" },
    "baselineTree": { "$ref": "#/$defs/sha40" },
    "candidateCommit": { "$ref": "#/$defs/sha40" },
    "candidateGitTree": { "$ref": "#/$defs/sha40" },
    "scannerPolicyVersion": { "type": "string", "pattern": "^secret-scan-policy/[A-Za-z0-9._-]+$" },
    "managedPaths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "configDigest": { "$ref": "#/$defs/digest" },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.local/managed-core/same-version-repair.schema.json",
  "title": "IDE managed-core exact-source same-version repair",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "targetWorktree", "packageVersion", "source", "installed", "paths"],
  "$defs": {
    "oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/|\\\\)(?!.*\\.\\.(?:/|\\\\|$))(?!.*:).+"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit", "tree", "manifestDigest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/oid" },
        "tree": { "$ref": "#/$defs/oid" },
        "manifestDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "installed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageVersion", "manifestDigest"],
      "properties": {
        "packageVersion": { "const": "2.5.2" },
        "manifestDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "pathRepair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "source", "installedSourceDigest", "installedDigest", "sourceDigest", "sourceBytes"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "source": { "$ref": "#/$defs/path" },
        "installedSourceDigest": { "$ref": "#/$defs/digest" },
        "installedDigest": { "$ref": "#/$defs/digest" },
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "sourceBytes": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ide-managed-same-version-repair" },
    "targetWorktree": { "type": "string", "minLength": 1 },
    "packageVersion": { "const": "2.5.2" },
    "source": { "$ref": "#/$defs/identity" },
    "installed": { "$ref": "#/$defs/installed" },
    "paths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pathRepair" } }
  }
}

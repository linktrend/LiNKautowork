{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.local/managed-core/managed-core-release.schema.json",
  "title": "IDE Development managed-core immutable release evidence (WP-01B / WP-07 locator)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "packageName",
    "packageVersion",
    "tag",
    "sourceCommit",
    "manifestHash",
    "repository",
    "archives",
    "publisher",
    "publicationStatus",
    "dryRun",
    "createdAt",
    "locator"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "ide-development-managed-core-release"
    },
    "packageName": {
      "type": "string",
      "const": "ide-development-managed-core"
    },
    "packageVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-][0-9A-Za-z.-]+)?$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+([.-][0-9A-Za-z.-]+)?$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "manifestHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "releaseUrl": {
      "type": ["string", "null"],
      "description": "GitHub Release HTML URL when published; null while pending_governed_publish."
    },
    "releaseId": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "archives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format", "name", "sha256", "bytes"],
        "properties": {
          "format": {
            "type": "string",
            "enum": ["tar.gz", "zip"]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._@+, \\-]+$"
          },
          "sha256": {
            "$ref": "#/$defs/sha256Digest"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "publisher": {
      "type": "string",
      "const": "linktrend-managed-core-release-publisher"
    },
    "publicationStatus": {
      "type": "string",
      "enum": [
        "pending_governed_publish",
        "verified",
        "published"
      ]
    },
    "dryRun": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "sourceCommit", "manifestHash", "primaryArchive"],
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "manifestHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "primaryArchive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "name", "sha256", "bytes"],
          "properties": {
            "format": {
              "type": "string",
              "enum": ["tar.gz", "zip"]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256Digest"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.local/managed-core/phase-record.schema.json",
  "title": "Phase Packager/Coordinator exact Phase record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "kind",
    "repository",
    "phaseBranch",
    "baseSha",
    "headSha",
    "gitTree",
    "candidateRevision",
    "acceptedCommits",
    "dependencyOrder",
    "sealed",
    "component"
  ],
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "acceptedCommit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "sha", "order"],
      "properties": {
        "branch": { "type": "string", "pattern": "^issue/[1-9][0-9]{0,8}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "sha": { "$ref": "#/$defs/sha40" },
        "order": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "phase-record" },
    "deliveryMode": { "type": "string", "const": "phase-integration" },
    "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "phaseId": { "type": "string", "minLength": 1 },
    "phaseBranch": { "type": "string", "pattern": "^phase/[A-Za-z0-9._-]+$" },
    "baseSha": { "$ref": "#/$defs/sha40" },
    "immutableBaseSha": { "$ref": "#/$defs/sha40" },
    "headSha": { "$ref": "#/$defs/sha40" },
    "gitTree": { "$ref": "#/$defs/sha40" },
    "candidateRevision": { "type": "string", "minLength": 1 },
    "acceptedCommits": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/acceptedCommit" }
    },
    "dependencyOrder": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptedIssues": { "type": "array" },
    "phasePr": { "type": ["object", "null"] },
    "sealed": { "type": "boolean", "const": false },
    "sealRevision": { "type": "integer", "minimum": 0 },
    "fast": { "type": "object" },
    "full": { "type": "object" },
    "namedGateEvidence": { "type": "object" },
    "component": { "type": "string", "const": "phase_packager_coordinator" },
    "status": { "type": "string" },
    "fastTrigger": { "type": "string", "const": "phase_pr" },
    "checkpointCI": { "type": "boolean", "const": false },
    "fullDispatchAllowed": { "type": "boolean", "const": false },
    "fullMayStart": { "type": "object" },
    "previousCandidateRevision": { "type": "string" },
    "invalidatedFromSha": { "$ref": "#/$defs/sha40" }
  }
}

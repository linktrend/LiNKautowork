{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.local/managed-core/release-candidate.schema.json",
  "title": "IDE Development managed-core release-candidate metadata (v2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "packageName",
    "packageVersion",
    "sourceCommit",
    "manifestHash",
    "archives",
    "supportedPlatforms",
    "provenance",
    "installInstructions",
    "rollbackInstructions",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "ide-development-release-candidate"
    },
    "packageName": {
      "type": "string",
      "const": "ide-development-managed-core"
    },
    "packageVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-][0-9A-Za-z.-]+)?$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Immutable git commit SHA of the package source tree used to build this RC."
    },
    "manifestHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 of core/managed-core/MANIFEST.json bytes after deterministic regeneration."
    },
    "archives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format", "path", "sha256", "bytes"],
        "properties": {
          "format": {
            "type": "string",
            "enum": ["tar.gz", "zip"]
          },
          "path": {
            "$ref": "#/$defs/repoRelativePath",
            "description": "Repository-relative path under an ignored build/ directory (never committed)."
          },
          "sha256": {
            "$ref": "#/$defs/sha256Digest"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "supportedPlatforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["darwin", "linux", "windows"]
      },
      "uniqueItems": true
    },
    "acceptanceEvidence": {
      "type": "array",
      "description": "Repository-relative evidence or test identities bound into the RC (no host paths).",
      "items": {
        "$ref": "#/$defs/repoRelativePath"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identities", "exclusions"],
      "properties": {
        "identities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/repoRelativePath"
          },
          "description": "Only repository-relative package identities (no absolute host paths)."
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Human-readable exclusion classes applied (credentials, git metadata, caches, etc.)."
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "python": {
              "type": "string",
              "description": "Python version string used for packaging (informational)."
            },
            "archiveEpochUtc": {
              "type": "string",
              "const": "2026-08-01T00:00:00Z"
            }
          }
        }
      }
    },
    "installInstructions": {
      "type": "string",
      "minLength": 1
    },
    "rollbackInstructions": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "const": "2026-08-01T00:00:00Z",
      "description": "Deterministic packaging epoch (not wall-clock) for reproducible metadata."
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/|\\\\)(?!.*\\.\\.(?:/|\\\\|$))(?!.*:)[A-Za-z0-9._@+, \\-]+(?:/[A-Za-z0-9._@+, \\-]+)*$",
      "description": "POSIX-style relative path inside the repository. No absolute paths, drive letters, or .. segments."
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.local/managed-core/secret-scan-fixtures.schema.json",
  "title": "Fixture-aware secret-scan declarations",
  "description": "Exact versioned non-production synthetic-fixture declarations. Bound to file, line/field, digest, candidate content tree, and scanner policy. Realistic credentials can never be approved.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "scannerPolicyVersion",
    "candidateTree",
    "fixtures"
  ],
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "secret-scan-fixtures" },
    "scannerPolicyVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^secret-scan-policy/[A-Za-z0-9._-]+$"
    },
    "candidateTree": { "$ref": "#/$defs/sha40" },
    "fixtures": {
      "type": "array",
      "description": "Fixture declarations. Each fixture id must be unique within this array; duplicates are rejected as malformed.",
      "x-uniqueItemFields": ["id"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "line",
          "field",
          "rule",
          "digest",
          "purpose",
          "production"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique fixture identity within this declaration."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\x00]+$"
          },
          "line": { "type": "integer", "minimum": 1 },
          "field": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 },
          "digest": { "$ref": "#/$defs/digest" },
          "bytes": {
            "type": "string",
            "minLength": 1,
            "description": "When present, must equal the detected fixture value. Scanned and never used to hide credentials."
          },
          "purpose": { "type": "string", "minLength": 1 },
          "production": { "type": "boolean", "const": false }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.local/managed-core/ci-component-manifest.schema.json",
  "title": "Executed Full coverage component manifest",
  "description": "Machine-readable proof that each mandatory Full component ran or was truthfully omitted by an authorized affected-surface decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "candidateHead",
    "candidateTree",
    "components"
  ],
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "ci-component-manifest" },
    "candidateHead": { "$ref": "#/$defs/sha40" },
    "candidateTree": { "$ref": "#/$defs/sha40" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "omitted"]
          },
          "evidencePath": { "type": "string", "minLength": 1 },
          "diagnosticPath": { "type": "string", "minLength": 1 },
          "innermostDiagnostic": { "type": "string", "minLength": 1 },
          "omission": {
            "type": "object",
            "additionalProperties": false,
            "required": ["authorized", "classifierDigest", "inputsDigest"],
            "properties": {
              "authorized": { "type": "boolean" },
              "classifierDigest": { "$ref": "#/$defs/digest" },
              "inputsDigest": { "$ref": "#/$defs/digest" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}

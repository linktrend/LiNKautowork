{
  "schemaVersion": 1,
  "kind": "external-cleanup-plan",
  "executable": false,
  "planId": "ide-development-github-compute-final-fix",
  "applyAuthority": "W3",
  "description": "Redacted external cleanup inventory. Names and identifiers only; no secret values.",
  "repositories": [
    "linktrend/openclaw_prime",
    "linktrend/LiNKplatform",
    "linktrend/LiNKskills",
    "linktrend/LiNKbrain",
    "linktrend/LiNKsites",
    "linktrend/LiNKdeveloper",
    "linktrend/LiNKlibraries",
    "linktrend/LiNKautowork",
    "linktrend/LiNKtrading-codebase"
  ],
  "targets": [
    {
      "id": "github-app.installation",
      "kind": "github-app-installation",
      "name": "former-custom-linktrend-gitops-app",
      "action": "remove-after-all-repositories-are-migrated"
    },
    {
      "id": "github-auth.secret-names",
      "kind": "actions-secret-or-variable-name",
      "names": [
        "LINKTREND_GITOPS_APP_ID",
        "LINKTREND_GITOPS_APP_PRIVATE_KEY",
        "LINKTREND_AUTOMATION_TOKEN",
        "LINKTREND_BUGBOT_USER_TOKEN",
        "LINKTREND_APP_TOKEN",
        "AUTOMATION_TOKEN",
        "BUGBOT_USER_TOKEN"
      ],
      "action": "remove-former-app-and-mac-automation-names-only"
    },
    {
      "id": "github-runners.labels",
      "kind": "runner-registration-or-label",
      "names": [
        "linktrend-private-macos-arm64",
        "linktrend-privileged",
        "linktrend-ci-isolated",
        "self-hosted",
        "macOS",
        "Linux",
        "ARM64"
      ],
      "action": "remove-ide-owned-registrations-only"
    },
    {
      "id": "mac-services.coordinator",
      "kind": "launchd-service-or-host-hook",
      "names": [
        "ai.linktrend.ide-coordinator",
        "scripts/host/install-ide-coordinator.py",
        "scripts/host/uninstall-ide-coordinator.py",
        "host/macos/ai.linktrend.ide-coordinator.plist.template"
      ],
      "action": "remove-ide-owned-service-material-only"
    },
    {
      "id": "docker.runner-resources",
      "kind": "docker-runner-resource",
      "names": [
        "linktrend/actions-runner-isolated",
        "linktrend-ci-isolated",
        "linktrend-privileged"
      ],
      "action": "remove-ide-owned-containers-images-volumes-networks-only"
    },
    {
      "id": "managed-workflows.legacy",
      "kind": "workflow-or-managed-file",
      "names": [
        "former-custom-app-publisher",
        "former-packager",
        "former-integrator",
        "former-repair-observer",
        "former-promotion-helper",
        "local-coordinator-dispatch"
      ],
      "action": "replace-with-hosted-workflows-before-external-cleanup"
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/linktrend/LiNKlibraries/schemas/catalog.schema.json",
  "title": "LiNKlibraries generated catalog",
  "description": "Canonical deterministic catalog contract v2; generatedAt and sourceCommitSha are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entriesSha256", "entries"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "entriesSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/catalogEntry"
      }
    }
  },
  "$defs": {
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "runtimes"],
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "runtimes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "operatingSystems": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "packageDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "ecosystem"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "ecosystem": {
          "type": "string",
          "enum": ["npm", "pypi", "cargo", "go", "maven", "nuget", "other"]
        },
        "optional": {
          "type": "boolean"
        }
      }
    },
    "serviceDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "purpose", "required"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packages", "services"],
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packageDependency"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serviceDependency"
          }
        }
      }
    },
    "catalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryId",
        "kind",
        "name",
        "summary",
        "problemDomains",
        "tags",
        "languages",
        "frameworks",
        "state",
        "contentMode",
        "selectable",
        "compatibility",
        "dependencies",
        "path"
      ],
      "properties": {
        "entryId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "custom_component",
            "code_pattern",
            "template",
            "starter_kit",
            "vetted_oss"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "problemDomains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "state": {
          "type": "string",
          "enum": [
            "usable",
            "metadata_only",
            "deprecated",
            "quarantined",
            "superseded"
          ]
        },
        "contentMode": {
          "type": "string",
          "enum": ["executable", "documentation"]
        },
        "selectable": {
          "type": "boolean"
        },
        "compatibility": {
          "$ref": "#/$defs/compatibility"
        },
        "dependencies": {
          "$ref": "#/$defs/dependencies"
        },
        "supersededBy": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "path": {
          "type": "string",
          "pattern": "^entries/[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    }
  }
}

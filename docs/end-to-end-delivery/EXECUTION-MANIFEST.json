    },
    "durableHeartbeat": {
      "writeReadbackRequired": true,
      "persistBeforeMutation": true
    },
    "checkoutBoundVerification": {
      "bindToCheckout": true,
      "forbidMergeRefIdentity": true
    },
    "retryExhaustion": {
      "diagnoseBeforeRecovery": true,
      "forbidSilentRetry": true,
      "ordinaryRecovery": "new_identity",
      "infrastructureRecovery": "hold",
      "codeFailureRecovery": "new_identity"
    },
    "hostedCapacityScheduler": {
      "requireCompleteSnapshot": true,
      "busyIsNotDiagnosis": true,
      "unknownIsBlocking": true,
      "hostedConcurrencyAuthority": "execution-protocol",
      "maxAdmittedSlots": {"local": 1},
      "adaptiveConcurrency": {
        "mode": "minimum_of_live_evidence",
        "capacityEvidence": "authenticated_cursor_account",
        "identityFields": ["accountId", "apiKeyName", "teamId", "programRunId"],
        "spendCeilingEvidence": "required",
        "safetyConstraintEvidence": "required",
        "evidenceMaxAgeSeconds": 900
      },
      "unknownProbeSeconds": 600,
      "backstopSeconds": 600,
      "prioritization": ["priority", "dependencyReady", "fifo"],
      "utilizationGapEvent": "UTILIZATION_GAP",
      "recomputeOnEvents": [
        "admission",
        "completion",
        "invalidation",
        "probe_timeout",
        "api_rejection",
        "utilization_gap_repair"
      ]
    },
    "packetRouting": {
      "digestBound": true,
      "preferredRoutes": ["grok", "independent_review", "specialist"],
      "thirdPartyRequiresException": true,
      "oneHopFallback": true,
      "exceptionEvidence": ["capability", "security", "independence", "context"]
    },
    "cursorCloudExecution": {
      "preDispatchAdvertisedRefValidation": true,
      "missingRefAction": "rebaseline_and_recreate_branch",
      "preparedSupersession": {
        "immutable": true,
        "requiresNewIntent": true,
        "neverReuseCloudAttempt": true,
        "supersedeObsoleteFixedCapacity": true,

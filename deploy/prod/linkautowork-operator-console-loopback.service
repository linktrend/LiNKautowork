[Unit]
Description=LiNKautowork operator console loopback relay (127.0.0.1:18803)
After=docker.service network-online.target
Requires=docker.service

[Service]
ExecStart=/usr/bin/python3 /srv/linktrend/deploy/linkautowork/current/ops/operator-console-loopback.py
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

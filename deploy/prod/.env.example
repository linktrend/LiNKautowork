# Names-only production contract. Values are placeholders. Live GSM resolve,
# Server01, Tailscale, registry, and provider apply remain HOLD (AW-08).
# Do not put secret values in this file.

# n8n private operator route (Traefik/Tailscale templates; no host port)
TRAEFIK_N8N_HOST=<OPERATOR_N8N_DNS_NAME>
N8N_HOST=<OPERATOR_N8N_DNS_NAME>
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_SECURE_COOKIE=true
N8N_EDITOR_BASE_URL=https://<OPERATOR_N8N_DNS_NAME>
WEBHOOK_URL=https://<OPERATOR_N8N_DNS_NAME>/
N8N_TAILSCALE_IP=
N8N_ENCRYPTION_KEY_SECRET_NAME=LINKAUTOWORK_N8N_ENCRYPTION_KEY_PROD

# Supabase / Platform (names only)
SUPABASE_DB_HOST=<APPROVED_PLATFORM_DB_HOST>
SUPABASE_DB_SESSION_POOLER_HOST=
SUPABASE_DB_HOST_IPV4=
SUPABASE_DB_PORT=5432
SUPABASE_DB_DATABASE=postgres
SUPABASE_DB_USER=<APPROVED_SCOPED_DB_USER>
SUPABASE_DB_PASSWORD_SECRET_NAME=LINKAUTOWORK_SUPABASE_DB_PASSWORD_PROD
SUPABASE_URL=https://<APPROVED_PLATFORM_PROJECT>.supabase.co
SUPABASE_SERVICE_ROLE_KEY_SECRET_NAME=LINKAUTOWORK_SUPABASE_SERVICE_ROLE_KEY_PROD
SUPABASE_RUNTIME_JWT_SECRET_NAME=LINKAUTOWORK_SUPABASE_RUNTIME_JWT_PROD
SUPABASE_AUDIT_RPC=linkautowork_write_audit_run

# n8n Admin API (inactive until AW-08 canary authority)
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY_SECRET_NAME=LINKAUTOWORK_N8N_API_KEY_PROD
N8N_API_BASE_PATH=/api/v1
N8N_WEBHOOK_PATH_PREFIX=/webhook

# gateway
PORT=8080
REPLAY_WINDOW_SECONDS=300
ACTIVE_TENANT_UUID=00000000-0000-0000-0000-000000000001
ACTIVE_TENANT_SLUG=linktrend_internal
LINK_HMAC_SHARED_SECRETS_SECRET_NAME=LINKAUTOWORK_LINK_HMAC_SHARED_SECRETS_PROD
LINK_SERVICE_TOKENS_SECRET_NAME=LINKAUTOWORK_LINK_SERVICE_TOKENS_PROD
LINK_CONTROL_TOKEN_SECRET_NAME=LINKAUTOWORK_LINK_CONTROL_TOKEN_PROD
LIBRARIAN_JWT_ISSUER=https://<APPROVED_PLATFORM_ISSUER>
LIBRARIAN_JWT_AUDIENCE=linkautowork-librarian
LIBRARIAN_JWKS_URL=https://<APPROVED_PLATFORM_ISSUER>/.well-known/jwks.json
LIBRARIAN_JWKS_CACHE_TTL_SECONDS=300
EVAL_RECEIPT_VERIFIER_KEYS_SECRET_NAME=LINKAUTOWORK_EVAL_RECEIPT_VERIFIER_KEYS_PROD

# event bridge (Docker DNS on autowork-events)
NATS_URL=nats://nats:4222

# GSM project placeholder — never a live project id in source
GCP_PROJECT_ID=<APPROVED_GSM_PROJECT_ID>
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-service-account
GOOGLE_APPLICATION_CREDENTIALS_DOCKER_SECRET_NAME=linkautowork-gcp-service-account

# Product/API runtime (injected by placeholder renderer; live values HOLD)
PRODUCT_API_PORT=8080
PRODUCT_API_JWT_ISSUER=https://<APPROVED_PLATFORM_ISSUER>
PRODUCT_API_JWT_AUDIENCE=linkautowork-product-api
PRODUCT_API_JWKS_URL=https://<APPROVED_PLATFORM_ISSUER>/.well-known/jwks.json
PRODUCT_API_WEBHOOK_SECRET_NAME=LINKAUTOWORK_PRODUCT_API_WEBHOOK_PROD
PRODUCT_API_SERVICE_TOKEN_SECRET_NAME=LINKAUTOWORK_PRODUCT_API_SERVICE_TOKEN_PROD
PRODUCT_API_SERVICE_ROLE_TOKEN_SECRET_NAME=LINKAUTOWORK_PRODUCT_API_SERVICE_ROLE_TOKEN_PROD
PRODUCT_API_POSTGREST_URL=https://<APPROVED_PLATFORM_PROJECT>.supabase.co/rest/v1
PRODUCT_API_SESSION_URL=https://<APPROVED_PLATFORM_SESSION_AUTHORITY>
PUBLIC_CLIENT_ORIGIN=https://<PUBLIC_CLIENT_DNS_NAME>
OPERATOR_CONSOLE_ORIGIN=https://<OPERATOR_CONSOLE_DNS_NAME>
PUBLIC_PRODUCT_API_ORIGIN=https://<PRODUCT_API_PRIVATE_DNS_NAME>
PLATFORM_OIDC_ISSUER=https://<APPROVED_PLATFORM_ISSUER>
PLATFORM_OIDC_CLIENT_ID=<APPROVED_CLIENT_PUBLIC_ID>
PLATFORM_OIDC_REDIRECT_URI=https://<PUBLIC_CLIENT_DNS_NAME>/
OPERATOR_OIDC_CLIENT_ID=<APPROVED_OPERATOR_PUBLIC_ID>
OPERATOR_OIDC_REDIRECT_URI=https://<OPERATOR_CONSOLE_DNS_NAME>/
OPERATIONS_SERVICE_TOKEN_SECRET_NAME=LINKAUTOWORK_OPERATIONS_SERVICE_TOKEN_PROD
OPERATIONS_PLATFORM_INVOCATION_TOKEN_SECRET_NAME=LINKAUTOWORK_OPERATIONS_PLATFORM_INVOCATION_TOKEN_PROD

# Slack destinations remain names-only; live send is HOLD
SLACK_SIGNING_SECRET_SECRET_NAME=LINKAUTOWORK_SLACK_SIGNING_SECRET_PROD
SLACK_OPERATIONS_WEBHOOK_URL_SECRET_NAME=LINKAUTOWORK_SLACK_OPERATIONS_WEBHOOK_URL_PROD
SLACK_APPROVALS_WEBHOOK_URL_SECRET_NAME=LINKAUTOWORK_SLACK_APPROVALS_WEBHOOK_URL_PROD

LINKAUTOWORK_GATEWAY_URL=http://gateway:8080
LINK_SERVICE_TOKEN_N8N_SECRET_NAME=LINKAUTOWORK_LINK_SERVICE_TOKEN_N8N_PROD

# AW-01 least-privilege role names (read-only input). Platform owns live grants.
LAUTOWORK_GATEWAY_DB_ROLE=svc_lautowork_gateway
LAUTOWORK_PRODUCT_API_DB_ROLE=svc_lautowork_product_api
LAUTOWORK_RUNTIME_DISPATCH_DB_ROLE=svc_lautowork_runtime_dispatch
LAUTOWORK_N8N_DB_ROLE=svc_lautowork_n8n
LAUTOWORK_OBSERVER_DB_ROLE=svc_observer
LAUTOWORK_MIGRATION_BACKUP_DB_ROLE=svc_lautowork_migration_backup

# Migration job stays dry-run in this packet
LINKAUTOWORK_MIGRATION_MODE=dry-run

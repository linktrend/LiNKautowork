# n8n runtime (Traefik on linkdroplet-00; direct Tailscale fallback via N8N_TAILSCALE_IP)
TRAEFIK_N8N_HOST=n8n.linktrend.internal
N8N_HOST=n8n.linktrend.internal
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_SECURE_COOKIE=true
N8N_EDITOR_BASE_URL=https://n8n.linktrend.internal
WEBHOOK_URL=https://n8n.linktrend.internal/
N8N_TAILSCALE_IP=
N8N_ENCRYPTION_KEY_SECRET_NAME=LINKAUTOWORK_N8N_ENCRYPTION_KEY_PROD

# Supabase
SUPABASE_DB_HOST=aws-0-xxx.pooler.supabase.com
SUPABASE_DB_SESSION_POOLER_HOST=
SUPABASE_DB_HOST_IPV4=
SUPABASE_DB_PORT=5432
SUPABASE_DB_DATABASE=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD_SECRET_NAME=LINKAUTOWORK_SUPABASE_DB_PASSWORD_PROD

SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY_SECRET_NAME=LINKAUTOWORK_SUPABASE_SERVICE_ROLE_KEY_PROD
SUPABASE_AUDIT_RPC=linkautowork_write_audit_run

# n8n Admin API used by kill-switch global revocation
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY_SECRET_NAME=LINKAUTOWORK_N8N_API_KEY_PROD
N8N_API_BASE_PATH=/api/v1
N8N_WEBHOOK_PATH_PREFIX=/webhook

# gateway auth/signature
PORT=8080
REPLAY_WINDOW_SECONDS=300
ACTIVE_TENANT_UUID=00000000-0000-0000-0000-000000000001
ACTIVE_TENANT_SLUG=linktrend_internal
LINK_HMAC_SHARED_SECRETS_SECRET_NAME=LINKAUTOWORK_LINK_HMAC_SHARED_SECRETS_PROD
LINK_SERVICE_TOKENS_SECRET_NAME=LINKAUTOWORK_LINK_SERVICE_TOKENS_PROD
LINK_CONTROL_TOKEN_SECRET_NAME=LINKAUTOWORK_LINK_CONTROL_TOKEN_PROD

# event bridge
NATS_URL=nats://nats:4222
ENABLE_INTERNAL_MIRROR_SUBJECTS=true

# GSM
GCP_PROJECT_ID=replace
GOOGLE_APPLICATION_CREDENTIALS=/etc/linktrend/gcp/linkbot-901208-e7677c682cff.json
GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH=/etc/linktrend/gcp/linkbot-901208-e7677c682cff.json

# Slack signatures
SLACK_SIGNING_SECRET_SECRET_NAME=LINKAUTOWORK_SLACK_SIGNING_SECRET_PROD

# workflow integration envs
LINKAUTOWORK_GATEWAY_URL=http://gateway:8080
LINKAUTOWORK_MVO_MODE=live
AUTOWORK_MODE=n8n
LINKAIOS_AUTOWORK_INVOKE_URL=https://linkaios.linktrend.internal/api/internal/autowork/workflows/invoke
LINKAUTOWORK_INVOKE_SECRET_SECRET_NAME=LINKTREND_AIOS_PROD_AUTOWORK_INVOKE_TOKEN
LINKAUTOWORK_PAYLOAD_BASE_URL=https://cms.linktrend.internal
LINKAUTOWORK_PAYLOAD_API_KEY_SECRET_NAME=LINKTREND_LINKSITES_PROD_PAYLOAD_API_KEY
LINKAUTOWORK_SUPABASE_URL=https://<project>.supabase.co
LINKAUTOWORK_SUPABASE_SERVICE_ROLE_KEY_SECRET_NAME=LINKTREND_AIOS_PROD_SUPABASE_SERVICE_ROLE
LINKAUTOWORK_ARTIFACT_ROOT=/var/linktrend/linksites-artifacts
LINK_SERVICE_TOKEN_N8N_SECRET_NAME=LINKAUTOWORK_LINK_SERVICE_TOKEN_N8N_PROD
PAPERCLIP_EVENT_URL=https://paperclip.internal/events
AIOS_GATE_REPORT_URL=https://paperclip.internal/gates
SUPABASE_HEALTH_RPC=https://<project>.supabase.co/rest/v1/rpc/linkautowork_health
SUPABASE_INCIDENT_RPC=https://<project>.supabase.co/rest/v1/rpc/linkautowork_open_incident
SUPABASE_INACTIVE_FILES_RPC=https://<project>.supabase.co/rest/v1/rpc/linkautowork_find_inactive_files
SUPABASE_POINTER_RPC=https://<project>.supabase.co/rest/v1/rpc/linkautowork_persist_pointer
SUPABASE_DELETE_FILE_RPC=https://<project>.supabase.co/rest/v1/rpc/linkautowork_delete_file
SLACK_OPERATIONS_WEBHOOK_URL_SECRET_NAME=LINKAUTOWORK_SLACK_OPERATIONS_WEBHOOK_URL_PROD
SLACK_APPROVALS_WEBHOOK_URL_SECRET_NAME=LINKAUTOWORK_SLACK_APPROVALS_WEBHOOK_URL_PROD

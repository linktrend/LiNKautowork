# n8n runtime (stage/dev)
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/
N8N_TAILSCALE_IP=
N8N_ENCRYPTION_KEY_SECRET_NAME=LINKAUTOWORK_N8N_ENCRYPTION_KEY_DEV

# Supabase (point at linkplatform-stage for live stage tests)
SUPABASE_DB_HOST=aws-0-xxx.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_DATABASE=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD_SECRET_NAME=LINKAUTOWORK_SUPABASE_DB_PASSWORD_DEV
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY_SECRET_NAME=LINKAUTOWORK_SUPABASE_SERVICE_ROLE_KEY_DEV
SUPABASE_AUDIT_RPC=linkautowork_write_audit_run

# n8n Admin API (template import + global kill-switch)
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY_SECRET_NAME=LINKAUTOWORK_N8N_API_KEY_DEV
N8N_API_BASE_PATH=/api/v1
N8N_WEBHOOK_PATH_PREFIX=/webhook

# gateway auth/signature
PORT=8080
REPLAY_WINDOW_SECONDS=300
ACTIVE_TENANT_UUID=00000000-0000-0000-0000-000000000001
ACTIVE_TENANT_SLUG=linktrend_internal
LINK_HMAC_SHARED_SECRETS_SECRET_NAME=LINKAUTOWORK_LINK_HMAC_SHARED_SECRETS_DEV
LINK_SERVICE_TOKENS_SECRET_NAME=LINKAUTOWORK_LINK_SERVICE_TOKENS_DEV
LINK_CONTROL_TOKEN_SECRET_NAME=LINKAUTOWORK_LINK_CONTROL_TOKEN_DEV

# event bridge
NATS_URL=nats://nats:4222
ENABLE_INTERNAL_MIRROR_SUBJECTS=true

# GSM
GCP_PROJECT_ID=replace
GOOGLE_APPLICATION_CREDENTIALS=/etc/linktrend/gcp/linkbot-901208-e7677c682cff.json
GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH=/etc/linktrend/gcp/linkbot-901208-e7677c682cff.json

# Slack (optional for MVO)
SLACK_SIGNING_SECRET_SECRET_NAME=LINKAUTOWORK_SLACK_SIGNING_SECRET_DEV
SLACK_OPERATIONS_WEBHOOK_URL_SECRET_NAME=LINKAUTOWORK_SLACK_OPERATIONS_WEBHOOK_URL_DEV
SLACK_APPROVALS_WEBHOOK_URL_SECRET_NAME=LINKAUTOWORK_SLACK_APPROVALS_WEBHOOK_URL_DEV

# gateway URL for n8n workflow nodes
LINKAUTOWORK_GATEWAY_URL=http://gateway:8080
LINK_SERVICE_TOKEN_N8N_SECRET_NAME=LINKAUTOWORK_LINK_SERVICE_TOKEN_N8N_DEV

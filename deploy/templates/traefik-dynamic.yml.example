# Initial-release private ingress template. Replace <...> only after authority
# is recorded. Public client-web is NOT routed in AW-05. Product API, gateway,
# n8n, and operator console stay Tailscale-private. Live Traefik apply is HOLD.
http:
  routers:
    linkautowork-operator-n8n:
      rule: "Host(`<OPERATOR_N8N_DNS_NAME>`)"
      entryPoints: [websecure]
      middlewares: [linkautowork-tailscale-only]
      service: linkautowork-n8n
      tls:
        certResolver: <APPROVED_TLS_RESOLVER>
    linkautowork-operator-console:
      rule: "Host(`<OPERATOR_CONSOLE_DNS_NAME>`)"
      entryPoints: [websecure]
      middlewares: [linkautowork-tailscale-only]
      service: linkautowork-operator-console
      tls:
        certResolver: <APPROVED_TLS_RESOLVER>
    linkautowork-product-api:
      rule: "Host(`<PRODUCT_API_PRIVATE_DNS_NAME>`)"
      entryPoints: [websecure]
      middlewares: [linkautowork-tailscale-only]
      service: linkautowork-product-api
      tls:
        certResolver: <APPROVED_TLS_RESOLVER>
    linkautowork-gateway:
      rule: "Host(`<GATEWAY_PRIVATE_DNS_NAME>`)"
      entryPoints: [websecure]
      middlewares: [linkautowork-tailscale-only]
      service: linkautowork-gateway
      tls:
        certResolver: <APPROVED_TLS_RESOLVER>
  middlewares:
    linkautowork-tailscale-only:
      ipAllowList:
        sourceRange: ["<TAILSCALE_CIDR>"]
  services:
    linkautowork-n8n:
      loadBalancer:
        servers: [{ url: "http://<N8N_PRIVATE_ADDRESS>:5678" }]
    linkautowork-operator-console:
      loadBalancer:
        servers: [{ url: "http://<OPERATOR_CONSOLE_PRIVATE_ADDRESS>:8080" }]
    linkautowork-product-api:
      loadBalancer:
        # Private container port; must match PRODUCT_API_PORT / Compose PORT (8080).
        servers: [{ url: "http://<PRODUCT_API_PRIVATE_ADDRESS>:8080" }]
    linkautowork-gateway:
      loadBalancer:
        servers: [{ url: "http://<GATEWAY_PRIVATE_ADDRESS>:8080" }]
